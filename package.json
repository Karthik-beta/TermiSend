{
  "name": "termisend",
  "version": "1.0.0",
  "description": "Local Email Outreach CLI with Terminal UI",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "start": "bun --env-file=.env.development run src/index.tsx",
    "dev": "bun --env-file=.env.development run src/index.tsx",
    "prod": "bun --env-file=.env.production run src/index.tsx",
    "build": "bun build ./src/index.tsx --outdir ./dist --target=bun",
    "shortcut:create": "bun run scripts/create-windows-shortcut.ts",
    "db:init": "bun run src/db.ts",
    "db:init:dev": "bun --env-file=.env.development run src/db.ts",
    "db:init:prod": "bun --env-file=.env.production run src/db.ts",
    "db:reset": "bun run src/db.ts reset",
    "db:reset:dev": "bun --env-file=.env.development run src/db.ts reset --confirm-reset",
    "db:reset:prod": "bun --env-file=.env.production run src/db.ts reset --confirm-reset --force-production-reset",
    "db:backup": "bun run scripts/backup-db.ts",
    "db:backup:prod": "bun run scripts/backup-db.ts --env production",
    "db:restore": "bun run scripts/restore-db.ts",
    "db:restore:prod": "bun run scripts/restore-db.ts --env production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1000.0",
    "@aws-sdk/client-sqs": "^3.1000.0",
    "dotenv": "^17.3.1",
    "exceljs": "4.4.0",
    "ink": "6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "marked": "^17.0.3",
    "postgres": "3.4.8",
    "react": "^19.0.0",
    "sharp": "0.34.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.14",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}

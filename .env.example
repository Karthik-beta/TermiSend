# Environment
NODE_ENV=development # development or production

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_password
DB_NAME=termisend

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
SES_FROM_EMAIL=noreply@yourdomain.com

# MyEmailVerifier API Configuration
MYEMAILVERIFIER_API_KEY=your_api_key

# Development / Safety Controls
# Set to an internal test email for dev/staging
TEST_RECIPIENT_EMAIL=test@yourdomain.com
# Set to 'false' to use real API in dev mode
SIMULATE_VERIFIER=true
# Set to 'false' to send to real recipients in dev mode
REDIRECT_EMAILS=true

# Email Throttling Configuration
THROTTLE_MIN_DELAY_MS=1000
THROTTLE_MAX_DELAY_MS=5000
THROTTLE_BREAK_PROBABILITY_PERCENT=5
THROTTLE_BREAK_MIN_MINUTES=3
THROTTLE_BREAK_MAX_MINUTES=10
SES_RATE_LIMIT_PER_SECOND=14
SES_QUOTA_BUFFER_PERCENT=10

# SES Analytics Configuration
# Enable/disable analytics collection (default: true)
ANALYTICS_ENABLED=true
# Sync interval in minutes for fetching SES analytics (default: 60)
ANALYTICS_SYNC_INTERVAL_MINUTES=60
# Data retention in days for analytics data (default: 90)
ANALYTICS_RETENTION_DAYS=90
# Rate limit in ms between SES analytics API calls (default: 1000, AWS limit: 1 req/sec)
ANALYTICS_RATE_LIMIT_MS=1000
